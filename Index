  const MINUTO_WORDS = { "cero":0,"y cuarto":15,"y media":30,"menos cuarto":45,
    "treinta":30,"quince":15,"cuarenta y cinco":45,"00":0,"30":30,"15":15,"45":45 };
  const DIA_WORDS = {
    "lunes":"Lun","martes":"Mar","miércoles":"Mié","jueves":"Jue",
