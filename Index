  };

  function parseVoiceCommand(transcript) {
    const t = transcript.toLowerCase().trim();

    // ── 1. Encontrar actividad ──
    const activityKeys = Object.keys(ACTIVITY_COLORS).filter(k => k !== "default");
    let foundActivity = null;
    for (const act of activityKeys) {
      if (t.includes(act.toLowerCase())) { foundActivity = act; break; }
    }
    // aliases
    if (!foundActivity) {
      if (t.includes("bus")) foundActivity = "Salida Bus";
      if (t.includes("avión") || t.includes("vuelo")) foundActivity = "Vuelo";
      if (t.includes("comer") || t.includes("almuerzo")) foundActivity = "Comida";
      if (t.includes("cenar")) foundActivity = "Cena";
      if (t.includes("dormir") || t.includes("descansar")) foundActivity = "Descanso";
    }

    // ── 2. Encontrar hora ──
    // Intenta primero formato numérico: "9:30", "21:00"
    let hour = null, minute = 0;
    const numMatch = t.match(/\b(\d{1,2})[:h\s](\d{2})\b/);
    if (numMatch) {
      hour = parseInt(numMatch[1]);
      minute = parseInt(numMatch[2]);
    } else {
      // Palabras: "nueve y media", "ocho treinta", "las once"
      for (const [word, val] of Object.entries(HORA_WORDS)) {
        const re = new RegExp(`\\b(las?\\s+)?${word}\\b`);
        if (re.test(t)) { hour = val; break; }
      }
      if (hour !== null) {
        if (t.includes("y media"))        minute = 30;
        else if (t.includes("y cuarto"))  minute = 15;
        else if (t.includes("treinta"))   minute = 30;
        else if (t.includes("cuarenta y cinco")) minute = 45;
        else if (t.includes("quince"))    minute = 15;
        else                              minute = 0;
      }
    }

    // ── 3. Encontrar día ──
    let foundDayPrefix = null;
    for (const [word, prefix] of Object.entries(DIA_WORDS)) {
      if (t.includes(word)) { foundDayPrefix = prefix; break; }
    }

    // ── 4. Resolver celda ──
    if (hour === null) return { ok: false, message: `No entendí la hora en: "${transcript}"` };
    if (!foundActivity) return { ok: false, message: `No entendí la actividad en: "${transcript}"` };

    const timeStr = `${String(hour).padStart(2,"0")}:${String(minute).padStart(2,"0")}`;

    // Encontrar columna correcta
    let targetDay = null;
    if (foundDayPrefix) {
      targetDay = dayColumns.find(d => formatDate(d).startsWith(foundDayPrefix)) || null;
    }
    if (!targetDay && dayColumns.length === 1) targetDay = dayColumns[0];
    if (!targetDay && dayColumns.length > 0) {
      // Si no se dijo día, usar el día del partido
      const md = new Date(match.fecha + "T12:00:00");
      targetDay = dayColumns.find(d => d.toDateString() === md.toDateString()) || dayColumns[0];
    }

    if (!targetDay) return { ok: false, message: "No pude identificar el día." };

    // Verificar que el slot existe
    if (!TIME_SLOTS.includes(timeStr)) {
      // Redondear al slot más cercano
      const slots30 = [0,30];
      const closestMin = slots30.reduce((a,b) => Math.abs(b-minute)<Math.abs(a-minute)?b:a);
      const adjTime = `${String(hour).padStart(2,"0")}:${String(closestMin).padStart(2,"0")}`;
      if (!TIME_SLOTS.includes(adjTime)) return { ok:false, message:`Hora ${timeStr} fuera de rango (07:00–00:00).` };
      minute = closestMin;
    }

    const finalTime = `${String(hour).padStart(2,"0")}:${String(minute).padStart(2,"0")}`;
    const dayLabel  = formatDate(targetDay);
    const key       = cellKey(dayLabel, finalTime);
    const entry     = `${finalTime} ${foundActivity}`;

    return { ok:true, key, entry, dayLabel, time:finalTime, activity:foundActivity,
      message:`✓ ${foundActivity} · ${finalTime} · ${dayLabel}` };
  }

  function startVoice() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
      setVoiceResult({ ok:false, message:"Tu navegador no soporta reconocimiento de voz. Usa Chrome o Safari." });
      return;
    }
    const rec = new SpeechRecognition();
    rec.lang = "es-ES";
    rec.continuous = false;
    rec.interimResults = true;
    rec.maxAlternatives = 3;

    rec.onstart  = () => { setVoiceActive(true); setVoiceTranscript(""); setVoiceResult(null); };
    rec.onend    = () => setVoiceActive(false);
    rec.onerror  = (e) => { setVoiceActive(false); setVoiceResult({ ok:false, message:`Error: ${e.error}` }); };

    rec.onresult = (e) => {
      const interim = Array.from(e.results).map(r => r[0].transcript).join(" ");
      setVoiceTranscript(interim);
      if (e.results[e.results.length-1].isFinal) {
        // Try all alternatives
        let parsed = null;
        for (let i = 0; i < e.results[0].length; i++) {
          const alt = e.results[0][i].transcript;
          const result = parseVoiceCommand(alt);
          if (result.ok) { parsed = result; break; }
        }
        if (!parsed) parsed = parseVoiceCommand(interim);
        if (parsed.ok) {
          setScheduleEntries(prev => ({ ...prev, [parsed.key]: parsed.entry }));
        }
        setVoiceResult(parsed);
      }
    };

    recognitionRef.current = rec;
    rec.start();
  }

