  async function handleExportPDF() {
    if (!scheduleRef.current) return;
    setPdfGenerating(true);

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${src}"]`)) return resolve();
        const s = document.createElement("script");
        s.src = src;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    try {
      await loadScript("https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js");
      await loadScript("https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js");

      const element = scheduleRef.current;
      const canvas = await window.html2canvas(element, {
        scale: 2,
        useCORS: true,
        backgroundColor: "#ffffff",
        logging: false,
      });

      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: "portrait", unit: "mm", format: "a4" });
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();
      const margin = 8;
      const usableW = pageW - margin * 2;
      const usableH = pageH - margin * 2;
      const canvasW = canvas.width;
      const canvasH = canvas.height;
      const ratio = usableW / canvasW;          // mm per px
      const totalRenderedH = canvasH * ratio;   // total height in mm if printed in one go

      // How many px fit on one page
      const pxPerPage = Math.floor(usableH / ratio);
      let pageTop = 0; // px offset into canvas
      let pageNum = 0;

      while (pageTop < canvasH) {
        if (pageNum > 0) pdf.addPage();
        const slicePx = Math.min(pxPerPage, canvasH - pageTop);

        // Create a slice canvas
        const sliceCanvas = document.createElement("canvas");
        sliceCanvas.width  = canvasW;
        sliceCanvas.height = slicePx;
        const ctx = sliceCanvas.getContext("2d");
        ctx.drawImage(canvas, 0, pageTop, canvasW, slicePx, 0, 0, canvasW, slicePx);

        const sliceData = sliceCanvas.toDataURL("image/jpeg", 0.92);
        const sliceH = slicePx * ratio;
        pdf.addImage(sliceData, "JPEG", margin, margin, usableW, sliceH);

        pageTop += pxPerPage;
        pageNum++;
        if (pageNum > 20) break;
      }

      const rivalName = match ? (match.esLocal ? match.visitante : match.local) : "partido";
      const filename = `Horario_RMCastilla_${rivalName.replace(/\s+/g,"_")}_${match?.fecha || ""}.pdf`;
      pdf.save(filename);
    } catch (err) {
      console.error("PDF error:", err);
      alert("No se pudo generar el PDF. Intenta usar Ctrl+P para imprimir.");
    } finally {
      setPdfGenerating(false);
    }
  }
  const [travelInfo, setTravelInfo]   = useState({ hotel:"", hotelDir:"", campo:"", campoDim:"", distCRM:"", distHotel:"" });
  const [newMatch, setNewMatch]       = useState({ jornada:"", local:"RM Castilla", visitante:"", fecha:"", hora:"12:00", esLocal:true, competicion:"Copa" });

  // ── ACTUALIZAR CALENDARIO ──
  const [showUpdateModal, setShowUpdateModal] = useState(false);
  const [updateText, setUpdateText]           = useState("");
  const [updateResult, setUpdateResult]       = useState(null); // { updated:[], notFound:[], raw:[] }
  const [ligaMatches, setLigaMatches]         = useState(LIGA_MATCHES);

  function parseCalendarText(text) {
    // Patrones que detecta:
    // "J30 · 29/03/2026 · 18:00" o "Jornada 30 ... 29 de marzo ... 18:00"
    // "Barakaldo - RM Castilla  29/03/2026  18:00"
    // "29/03  18:00  Barakaldo vs Castilla"
    // Formato RFEF: "J30 Barakaldo - Real Madrid Castilla 29/03/2026 18:00"
    const lines = text.split(/\n/).map(l => l.trim()).filter(Boolean);
    const results = [];

    // Regex para capturar fecha dd/mm/yyyy o dd/mm/yy o dd-mm-yyyy
    const rFecha = /(\d{1,2})[\/\-](\d{1,2})(?:[\/\-](\d{2,4}))?/;
    // Regex hora HH:MM
    const rHora = /\b(\d{1,2}):(\d{2})\b/;
    // Jornada
    const rJornada = /[Jj](?:ornada\s*)?(\d{1,2})/;

    for (const line of lines) {
      const fechaM = line.match(rFecha);
      const horaM  = line.match(rHora);
      if (!fechaM) continue; // sin fecha no sirve

      const dia = fechaM[1].padStart(2,"0");
      const mes = fechaM[2].padStart(2,"0");
      let anyo = fechaM[3] ? fechaM[3] : "2026";
      if (anyo.length === 2) anyo = "20" + anyo;
      const fecha = `${anyo}-${mes}-${dia}`;

      const hora = horaM ? `${horaM[1].padStart(2,"0")}:${horaM[2]}` : null;
      const jM   = line.match(rJornada);
      const jornada = jM ? parseInt(jM[1]) : null;

      results.push({ fecha, hora, jornada, raw: line });
    }
    return results;
  }

  function applyCalendarUpdate() {
    const parsed = parseCalendarText(updateText);
    if (!parsed.length) {
      setUpdateResult({ updated:[], notFound:[], raw:[] });
      return;
    }

    const updated   = [];
    const notFound  = [];
    const newMatches = ligaMatches.map(m => ({ ...m }));

    for (const p of parsed) {
      // Intentamos emparejar por jornada primero, luego por fecha aproximada
      let idx = -1;
      if (p.jornada) {
        idx = newMatches.findIndex(m => m.jornada === p.jornada);
      }
      if (idx === -1 && p.fecha) {
        // buscar por fecha exacta
        idx = newMatches.findIndex(m => m.fecha === p.fecha);
      }
      if (idx === -1 && p.fecha) {
        // buscar por fecha ±3 días
        const ts = new Date(p.fecha).getTime();
        idx = newMatches.findIndex(m => Math.abs(new Date(m.fecha).getTime() - ts) <= 3*86400000);
      }

      if (idx !== -1) {
        const before = { fecha: newMatches[idx].fecha, hora: newMatches[idx].hora };
        if (p.fecha) newMatches[idx].fecha = p.fecha;
        if (p.hora)  newMatches[idx].hora  = p.hora;
        newMatches[idx].provisional = false;
