          @page :first { size: A4 portrait; }
          button, select { display:none !important; }
          * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
      `}</style>
    </div>
  );
}

function MatchInfoBanner({ match, rival, competicion }) {
  return (
    <div style={{ background:C.blueDeep, borderRadius:7, padding:"12px 20px", display:"flex", alignItems:"center", gap:16, flexWrap:"wrap", borderLeft:`5px solid ${C.gold}` }}>
      <div style={{ flex:1 }}>
        <div style={{ fontSize:15, fontWeight:700, color:C.white, fontFamily:"'Georgia',serif" }}>
          {match.esLocal ? `RM Castilla — ${rival}` : `${rival} — RM Castilla`}
        </div>
        <div style={{ fontSize:11, color:"#A8C4E8", marginTop:2, fontFamily:"'Arial',sans-serif" }}>
          {competicion}{match.jornada?` · Jornada ${match.jornada}`:""} · {match.fecha} · {match.hora}h · {match.esLocal?"Local":"Visitante"}
        </div>
      </div>
    </div>
  );
}

function InfoCard({ title, fields, travelInfo, setTravelInfo, mapLabel, mapHeight=200 }) {
  return (
    <div style={{ background:C.white, borderRadius:8, border:`1px solid ${C.blueBorder}`, overflow:"hidden", boxShadow:"0 2px 10px rgba(0,48,135,.06)" }}>
      <div style={{ background:C.blueDeep, color:C.white, padding:"10px 18px", fontSize:11, fontWeight:700, letterSpacing:1, fontFamily:"'Arial',sans-serif" }}>
        {title.toUpperCase()}
      </div>
      <div style={{ padding:"16px 18px" }}>
        {fields.map(f => (
          <div key={f.key} style={{ marginBottom:12 }}>
            <label style={{ fontSize:10, color:C.textLight, display:"block", marginBottom:4, fontFamily:"'Arial',sans-serif", letterSpacing:.5, fontWeight:600 }}>
              {f.label.toUpperCase()}
            </label>
            <input value={travelInfo[f.key]||""} placeholder={f.placeholder||""}
              onChange={e => setTravelInfo(p => ({...p,[f.key]:e.target.value}))}
              style={{ width:"100%", background:C.offWhite, color:C.text, border:`1px solid ${C.blueBorder}`, borderRadius:5, padding:"8px 10px", fontSize:13, fontFamily:"inherit" }} />
          </div>
        ))}
        <div style={{ background:C.blueLight, borderRadius:6, height:mapHeight, display:"flex", alignItems:"center", justifyContent:"center", flexDirection:"column", gap:6, border:`1px dashed ${C.blueBorder}`, marginTop:4 }}>
          <span style={{ fontSize:22 }}>🗺</span>
          <span style={{ fontSize:11, color:C.textLight, fontFamily:"'Arial',sans-serif", textAlign:"center", padding:"0 16px" }}>{mapLabel}</span>
        </div>
      </div>
    </div>
  );
}
