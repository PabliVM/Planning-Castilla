function getActivityColor(text) {
  if (!text) return ACTIVITY_COLORS.default;
  const l = text.toLowerCase();
  if (l.includes("desayuno")) return ACTIVITY_COLORS["Desayuno"];
  if (l.includes("comida") || l.includes("pizza")) return ACTIVITY_COLORS["Comida"];
  if (l.includes("cena")) return ACTIVITY_COLORS["Cena"];
  if (l.includes("merienda")) return ACTIVITY_COLORS["Merienda"];
  if (l.includes("partido")) return ACTIVITY_COLORS["Partido"];
  if (l.includes("calentamiento")) return ACTIVITY_COLORS["Calentamiento"];
  if (l.includes("charla")) return ACTIVITY_COLORS["Charla"];
  if (l.includes("salida")) return ACTIVITY_COLORS["Salida Bus"];
  if (l.includes("llegada")) return ACTIVITY_COLORS["Llegada"];
  if (l.includes("descanso")) return ACTIVITY_COLORS["Descanso"];
  if (l.includes("picnic")) return ACTIVITY_COLORS["Picnic"];
  if (l.includes("vuelo") || l.includes("ib ")) return ACTIVITY_COLORS["Vuelo"];
  return ACTIVITY_COLORS.default;
}

