function generateTimeSlots() {
  const s = [];
  for (let h = 7; h <= 23; h++) { s.push(`${String(h).padStart(2,"0")}:00`); s.push(`${String(h).padStart(2,"0")}:30`); }
  s.push("00:00");
  return s;
}
