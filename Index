// Helpers de búsqueda flexible en STADIUM_DB
function getStadiumInfo(rivalName) {
  if (!rivalName) return null;
  const direct = STADIUM_DB[rivalName];
  if (direct) return direct;
  // búsqueda parcial
  const key = Object.keys(STADIUM_DB).find(k =>
    rivalName.toLowerCase().includes(k.toLowerCase()) ||
    k.toLowerCase().includes(rivalName.toLowerCase())
  );
  return key ? STADIUM_DB[key] : null;
}
